pipeline {
  agent any

  triggers { githubPush() }   // started by the GitHub webhook

  environment {
    AWS_DEFAULT_REGION    = 'us-east-1'
    AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
    AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    TF_IN_AUTOMATION      = 'true'
  }

  options { timestamps(); disableConcurrentBuilds() }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Stamp Build Info') {
      steps {
        sh '''
          COMMIT=$(git rev-parse --short HEAD)
          sed -i "s/__BUILD_NUMBER__/${BUILD_NUMBER}/; s/__GIT_COMMIT__/${COMMIT}/; s/__DEPLOY_TIME__/$(date -u '+%d %b %Y %H:%M UTC')/" website/index.html
        '''
      }
    }

    stage('Terraform Init & Validate') {
      steps {
        dir('terraform') {
          sh 'terraform init -input=false'
          sh 'terraform validate'
        }
      }
    }

    stage('Terraform Plan') {
      steps { dir('terraform') { sh 'terraform plan -input=false -out=tfplan' } }
    }

    stage('Terraform Apply') {
      steps { dir('terraform') { sh 'terraform apply -input=false -auto-approve tfplan' } }
    }

    stage('Deploy Website') {
      steps {
        sshagent(credentials: ['ec2-ssh-key']) {
          sh '''
            IP=$(terraform -chdir=terraform output -raw public_ip)
            SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 ubuntu@$IP"

            # wait until nginx is installed and running (first run only)
            for i in $(seq 1 30); do
              $SSH 'systemctl is-active --quiet nginx' && break
              echo "Waiting for EC2/nginx... ($i)"; sleep 10
            done

            scp -o StrictHostKeyChecking=no -r website/. ubuntu@$IP:/var/www/html/
            $SSH 'sudo systemctl reload nginx'
          '''
        }
      }
    }

    stage('Verify') {
      steps {
        sh '''
          IP=$(terraform -chdir=terraform output -raw public_ip)
          curl -fsS -o /dev/null -w "HTTP %{http_code}\\n" http://$IP
        '''
      }
    }
  }

  post {
    success { echo 'Deployed. Open the EC2 public IP in your browser.' }
    failure { echo 'Pipeline failed. Check the stage logs above.' }
  }
}